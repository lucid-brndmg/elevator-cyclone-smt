edge {SetMotionUp -> D}
edge {SetMotionDown -> D}
edge {SetIdle -> D}
edge {MoveUp -> D}
edge {MoveDown -> D}
edge {L0 -> D}
edge {L1 -> D}
edge {L2 -> D}
edge {L3 -> D}
edge {L4 -> D}
edge {D -> D where m == I && !l_u_0 && !l_u_1 && !l_u_2 && !l_u_3 && !l_d_1 && !l_d_2 && !l_d_3 && !l_d_4 && !l_c_0 && !l_c_1 && !l_c_2 && !l_c_3 && !l_c_4;}

invariant I6 {f_sw_u <= f_sw_d;}
invariant I7 {m_prev != m;} in (SetMotionDown, SetMotionUp, SetIdle)
invariant I9 {(m == U) => (f_sw_u <= f && ((f == 1 && f_sw_u == 0) => (!l_c_0 && !l_u_0)) && ((f == 2 && f_sw_u == 0) => (!l_c_0 && !l_u_0 && !l_c_1 && !l_u_1)) && ((f == 2 && f_sw_u == 1) => (!l_c_1 && !l_u_1)) && ((f == 3 && f_sw_u == 0) => (!l_c_0 && !l_u_0 && !l_c_1 && !l_u_1 && !l_c_2 && !l_u_2)) && ((f == 3 && f_sw_u == 1) => (!l_c_1 && !l_u_1 && !l_c_2 && !l_u_2)) && ((f == 3 && f_sw_u == 2) => (!l_c_2 && !l_u_2)) && ((f == 4 && f_sw_u == 0) => (!l_c_0 && !l_u_0 && !l_c_1 && !l_u_1 && !l_c_2 && !l_u_2 && !l_c_3 && !l_u_3)) && ((f == 4 && f_sw_u == 1) => (!l_c_1 && !l_u_1 && !l_c_2 && !l_u_2 && !l_c_3 && !l_u_3)) && ((f == 4 && f_sw_u == 2) => (!l_c_2 && !l_u_2 && !l_c_3 && !l_u_3)) && ((f == 4 && f_sw_u == 3) => (!l_c_3 && !l_u_3)));}
invariant I8 {(m == D) => (f <= f_sw_d && ((f == 0 && f_sw_d == 1) => (!l_c_1 && !l_d_1)) && ((f == 0 && f_sw_d == 2) => (!l_c_1 && !l_d_1 && !l_c_2 && !l_d_2)) && ((f == 0 && f_sw_d == 3) => (!l_c_1 && !l_d_1 && !l_c_2 && !l_d_2 && !l_c_3 && !l_d_3)) && ((f == 0 && f_sw_d == 4) => (!l_c_1 && !l_d_1 && !l_c_2 && !l_d_2 && !l_c_3 && !l_d_3 && !l_c_4 && !l_d_4)) && ((f == 1 && f_sw_d == 2) => (!l_c_2 && !l_d_2)) && ((f == 1 && f_sw_d == 3) => (!l_c_2 && !l_d_2 && !l_c_3 && !l_d_3)) && ((f == 1 && f_sw_d == 4) => (!l_c_2 && !l_d_2 && !l_c_3 && !l_d_3 && !l_c_4 && !l_d_4)) && ((f == 2 && f_sw_d == 3) => (!l_c_3 && !l_d_3)) && ((f == 2 && f_sw_d == 4) => (!l_c_3 && !l_d_3 && !l_c_4 && !l_d_4)) && ((f == 3 && f_sw_d == 4) => (!l_c_4 && !l_d_4)));}
invariant I11 {m == U && ((f == 0) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 1) => (l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 2) => (l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 3) => (l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 4) => (l_d_4 || l_c_4));} in (MoveUp, SetMotionUp)
invariant I10 {m == D && ((f == 0) => (l_u_0 || l_c_0)) && ((f == 1) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1)) && ((f == 2) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2)) && ((f == 3) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3)) && ((f == 4) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4));} in (MoveDown, SetMotionDown)
goal {

