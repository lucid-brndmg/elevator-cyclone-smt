option-trace = true;
graph Lift3 {
const int U = 0;
const int D = 1;
const int I = 2;
int m where m == U || m == D || m == I , m_prev = m where m_prev == U || m_prev == D || m_prev == I;
bool l_c_0, l_c_1, l_c_2, l_u_0, l_u_1, l_d_1, l_d_2;
int f where f >= 0 && f <= 2;
bool h_0 = false, h_1 = false, h_2 = false;
int f_sw_u = f where f_sw_u >= 0 && f_sw_u <= 2;
int f_sw_d = f where f_sw_d >= 0 && f_sw_d <= 2;
bool r_c_0, r_c_1, r_c_2, r_d_1, r_d_2, r_u_0, r_u_1, a_c_0 = l_c_0, a_c_1 = l_c_1, a_c_2 = l_c_2, a_u_0 = l_u_0, a_u_1 = l_u_1, a_d_1 = l_d_1, a_d_2 = l_d_2, s_u_0 = l_u_0, s_u_1 = l_u_1, s_d_1 = l_d_1, s_d_2 = l_d_2, s_c_0 = l_c_0, s_c_1 = l_c_1, s_c_2 = l_c_2;

normal state SetIdle {m_prev = m; s_u_0 = l_u_0; s_c_0 = l_c_0; s_u_1 = l_u_1; s_d_1 = l_d_1; s_c_1 = l_c_1; s_d_2 = l_d_2; s_c_2 = l_c_2; m = I; f_sw_u = f; f_sw_d = f;}
normal state SetMotionUp {m_prev = m; s_u_0 = l_u_0; s_c_0 = l_c_0; s_u_1 = l_u_1; s_d_1 = l_d_1; s_c_1 = l_c_1; s_d_2 = l_d_2; s_c_2 = l_c_2; m = U; f_sw_u = f;}
normal state SetMotionDown {m_prev = m; s_u_0 = l_u_0; s_c_0 = l_c_0; s_u_1 = l_u_1; s_d_1 = l_d_1; s_c_1 = l_c_1; s_d_2 = l_d_2; s_c_2 = l_c_2; m = D; f_sw_d = f;}
normal state MoveDown {f -= 1;}
normal state MoveUp {f += 1;}
normal state L0 {l_c_0 = false; s_c_0 = false; h_0 = true; l_u_0 = l_u_0 && !(m == U); s_u_0 = s_u_0 && !(m == U);}
normal state L1 {l_c_1 = false; s_c_1 = false; h_1 = true; l_u_1 = l_u_1 && !(m == U); s_u_1 = s_u_1 && !(m == U); l_d_1 = l_d_1 && !(m == D); s_d_1 = s_d_1 && !(m == D);}
normal state L2 {l_c_2 = false; s_c_2 = false; h_2 = true; l_d_2 = l_d_2 && !(m == D); s_d_2 = s_d_2 && !(m == D);}
normal start final state D {fresh(r_u_0); l_u_0 = l_u_0 || r_u_0; a_u_0 = a_u_0 || r_u_0; fresh(r_c_0); l_c_0 = l_c_0 || r_c_0; a_c_0 = a_c_0 || r_c_0; fresh(r_u_1); l_u_1 = l_u_1 || r_u_1; a_u_1 = a_u_1 || r_u_1; fresh(r_d_1); l_d_1 = l_d_1 || r_d_1; a_d_1 = a_d_1 || r_d_1; fresh(r_c_1); l_c_1 = l_c_1 || r_c_1; a_c_1 = a_c_1 || r_c_1; fresh(r_d_2); l_d_2 = l_d_2 || r_d_2; a_d_2 = a_d_2 || r_d_2; fresh(r_c_2); l_c_2 = l_c_2 || r_c_2; a_c_2 = a_c_2 || r_c_2;}

edge {D -> MoveUp where m == U && !((f == 0) && (l_u_0 || l_c_0) || (f == 1) && (l_u_1 || l_c_1) || (f == 2) && (l_c_2)) && ((f == 0) && (l_u_1 || l_d_1 || l_d_2 || l_c_1 || l_c_2) || (f == 1) && (l_d_2 || l_c_2));}
edge {D -> MoveDown where m == D && !((f == 0) && (l_c_0) || (f == 1) && (l_d_1 || l_c_1) || (f == 2) && (l_d_2 || l_c_2)) && ((f == 1) && (l_u_0 || l_c_0) || (f == 2) && (l_u_0 || l_u_1 || l_d_1 || l_c_0 || l_c_1));}
edge {D -> SetMotionDown where (f == 1) && ((m == U && !l_d_2 && !l_c_2 && !l_u_1 && !l_c_1) || m == I) && (l_u_0 || l_c_0 || l_d_1 || (m == I && l_c_1)) || (f == 2) && ((m == U && !l_c_2) || m == I) && (l_u_0 || l_u_1 || l_d_1 || l_c_0 || l_c_1 || l_d_2 || (m == I && l_c_2));}
edge {D -> SetMotionUp where (f == 0) && ((m == D && !l_c_0) || m == I) && (l_u_1 || l_d_1 || l_d_2 || l_c_1 || l_c_2 || l_u_0 || (m == I && l_c_0)) || (f == 1) && ((m == D && !l_u_0 && !l_c_0 && !l_d_1 && !l_c_1) || m == I) && (l_d_2 || l_c_2 || l_u_1 || (m == I && l_c_1));}
edge {D -> SetIdle where !(m == I) && !l_u_0 && !l_u_1 && !l_d_1 && !l_d_2 && !l_c_0 && !l_c_1 && !l_c_2;}
edge {D -> L0 where f == 0 && !(m == I) && (l_c_0 || (m == U && l_u_0));}
edge {D -> L1 where f == 1 && !(m == I) && (l_c_1 || (m == U && l_u_1) || (m == D && l_d_1));}
edge {D -> L2 where f == 2 && !(m == I) && (l_c_2 || (m == D && l_d_2));}
edge {SetMotionUp -> D}
edge {SetMotionDown -> D}
edge {SetIdle -> D}
edge {MoveUp -> D}
edge {MoveDown -> D}
edge {L0 -> D}
edge {L1 -> D}
edge {L2 -> D}
edge {D -> D where m == I && !l_u_0 && !l_u_1 && !l_d_1 && !l_d_2 && !l_c_0 && !l_c_1 && !l_c_2;}

invariant I0 {(a_u_0 || a_c_0) == h_0 && !l_u_0 && !l_c_0 && (a_u_1 || a_d_1 || a_c_1) == h_1 && !l_u_1 && !l_d_1 && !l_c_1 && (a_d_2 || a_c_2) == h_2 && !l_d_2 && !l_c_2;} in (SetIdle)
invariant I1 {!l_c_0 && !(m == I) && ((m == U) => (!l_u_0 && (a_u_0 || a_c_0))) && ((m == D) => (a_c_0));} in (L0)

invariant I2 {!l_c_1 && !(m == I) && ((m == U) => (!l_u_1 && (a_u_1 || a_c_1))) && ((m == D) => (!l_d_1 && (a_d_1 || a_c_1)));} in (L1)

invariant I3 {!l_c_2 && !(m == I) && ((m == U) => (a_c_2)) && ((m == D) => (!l_d_2 && (a_d_2 || a_c_2)));} in (L2)
invariant I4 {f_sw_u <= f_sw_d;}
invariant I5 {m_prev != m;} in (SetMotionDown, SetMotionUp, SetIdle)
invariant I7 {(m == U) => (f_sw_u <= f && ((f == 1 && f_sw_u == 0) => (!s_c_0 && !s_u_0)) && ((f == 2 && f_sw_u == 0) => (!s_c_0 && !s_u_0 && !s_c_1 && !s_u_1)) && ((f == 2 && f_sw_u == 1) => (!s_c_1 && !s_u_1)));}
invariant I6 {(m == D) => (f <= f_sw_d && ((f == 0 && f_sw_d == 1) => (!s_c_1 && !s_d_1)) && ((f == 0 && f_sw_d == 2) => (!s_c_1 && !s_d_1 && !s_c_2 && !s_d_2)) && ((f == 1 && f_sw_d == 2) => (!s_c_2 && !s_d_2)));}
invariant I9 {m == U && ((f == 0) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_c_2)) && ((f == 1) => (l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_c_2)) && ((f == 2) => (l_d_2 || l_c_2));} in (MoveUp, SetMotionUp)
invariant I8 {m == D && ((f == 0) => (l_u_0 || l_c_0)) && ((f == 1) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1)) && ((f == 2) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_c_2));} in (MoveDown, SetMotionDown)
goal {

check for 4  reach (MoveUp, MoveDown, D, SetMotionUp, SetMotionDown, SetIdle, L0, L1, L2)
}
}