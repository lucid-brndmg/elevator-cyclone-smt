option-trace = true;
graph Lift3 {
const int U = 0;
const int D = 1;
const int I = 2;
int m where m == U || m == D || m == I , m_prev = m where m_prev == U || m_prev == D || m_prev == I;
bool l_c_0, l_c_1, l_c_2, l_u_0, l_u_1, l_d_1, l_d_2;
int f where f >= 0 && f <= 2;
int sc = 0, sc_MoveUp = 0, sc_MoveDown = 0, sc_D = 0, sc_SetMotionUp = 0, sc_SetMotionDown = 0, sc_SetIdle = 0, sc_L0 = 0, sc_L1 = 0, sc_L2 = 0;
int f_sw_u = f where f_sw_u >= 0 && f_sw_u <= 2;
int f_sw_d = f where f_sw_d >= 0 && f_sw_d <= 2;

normal state SetIdle {m_prev = m; m = I; f_sw_u = f; f_sw_d = f; sc += 1; sc_SetIdle += 1;}
normal state SetMotionUp {m_prev = m; m = U; f_sw_u = f; sc += 1; sc_SetMotionUp += 1;}
normal state SetMotionDown {m_prev = m; m = D; f_sw_d = f; sc += 1; sc_SetMotionDown += 1;}
normal state MoveDown {f -= 1; sc += 1; sc_MoveDown += 1;}
normal state MoveUp {f += 1; sc += 1; sc_MoveUp += 1;}
normal state L0 {l_c_0 = false; l_u_0 = l_u_0 && !(m == U); sc += 1; sc_L0 += 1;}
normal state L1 {l_c_1 = false; l_u_1 = l_u_1 && !(m == U); l_d_1 = l_d_1 && !(m == D); sc += 1; sc_L1 += 1;}
normal state L2 {l_c_2 = false; l_d_2 = l_d_2 && !(m == D); sc += 1; sc_L2 += 1;}
normal start final state D {sc += 1; sc_D += 1;}

edge {D -> MoveUp where m == U && !((f == 0) && (l_u_0 || l_c_0) || (f == 1) && (l_u_1 || l_c_1) || (f == 2) && (l_c_2)) && ((f == 0) && (l_u_1 || l_d_1 || l_d_2 || l_c_1 || l_c_2) || (f == 1) && (l_d_2 || l_c_2));}
edge {D -> MoveDown where m == D && !((f == 0) && (l_c_0) || (f == 1) && (l_d_1 || l_c_1) || (f == 2) && (l_d_2 || l_c_2)) && ((f == 1) && (l_u_0 || l_c_0) || (f == 2) && (l_u_0 || l_u_1 || l_d_1 || l_c_0 || l_c_1));}
edge {D -> SetMotionDown where (f == 1) && ((m == U && !l_d_2 && !l_c_2 && !l_u_1 && !l_c_1) || m == I) && (l_u_0 || l_c_0 || l_d_1 || (m == I && l_c_1)) || (f == 2) && ((m == U && !l_c_2) || m == I) && (l_u_0 || l_u_1 || l_d_1 || l_c_0 || l_c_1 || l_d_2 || (m == I && l_c_2));}
edge {D -> SetMotionUp where (f == 0) && ((m == D && !l_c_0) || m == I) && (l_u_1 || l_d_1 || l_d_2 || l_c_1 || l_c_2 || l_u_0 || (m == I && l_c_0)) || (f == 1) && ((m == D && !l_u_0 && !l_c_0 && !l_d_1 && !l_c_1) || m == I) && (l_d_2 || l_c_2 || l_u_1 || (m == I && l_c_1));}
edge {D -> SetIdle where !(m == I) && !l_u_0 && !l_u_1 && !l_d_1 && !l_d_2 && !l_c_0 && !l_c_1 && !l_c_2;}
edge {D -> L0 where f == 0 && !(m == I) && (l_c_0 || (m == U && l_u_0));}
edge {D -> L1 where f == 1 && !(m == I) && (l_c_1 || (m == U && l_u_1) || (m == D && l_d_1));}
edge {D -> L2 where f == 2 && !(m == I) && (l_c_2 || (m == D && l_d_2));}
edge {SetMotionUp -> D}
edge {SetMotionDown -> D}
edge {SetIdle -> D}
edge {MoveUp -> D}
edge {MoveDown -> D}
edge {L0 -> D}
edge {L1 -> D}
edge {L2 -> D}
edge {D -> D where m == I && !l_u_0 && !l_u_1 && !l_d_1 && !l_d_2 && !l_c_0 && !l_c_1 && !l_c_2;}

// halt
invariant I0 {(sc == 27) => (m == I 
  && sc_SetIdle + sc_SetMotionUp + sc_SetMotionDown <= 4
  && sc_L0 + sc_L1 + sc_L2 <= 6
  && sc_MoveUp + sc_MoveDown <= 3);} // agg


// idling
invariant I1 {sc_SetIdle <= 1 && (sc_SetIdle == 1) => (m == I && !l_c_0 && !l_c_1 && !l_c_2 && !l_u_0 && !l_u_1 && !l_d_1 && !l_d_2);}
invariant I2 {(sc == 27) => ((sc_SetMotionUp + sc_SetMotionDown != 0) => (sc_SetIdle == 1));} // agg
invariant I3 {(initial(m) == I && sc == 2 && (initial(l_c_0) || initial(l_c_1) || initial(l_c_2) || initial(l_u_0) || initial(l_u_1) || initial(l_d_1) || initial(l_d_2))) => (m == U && sc_SetMotionUp == 1 || m == D && sc_SetMotionDown == 1);}


// level-handling
invariant I4 {(initial(l_u_0) || initial(l_c_0)) == (sc_L0 != 0) && !l_u_0 && !l_c_0 && (initial(l_u_1) || initial(l_d_1) || initial(l_c_1)) == (sc_L1 != 0) && !l_u_1 && !l_d_1 && !l_c_1 && (initial(l_d_2) || initial(l_c_2)) == (sc_L2 != 0) && !l_d_2 && !l_c_2;} in (SetIdle)
invariant I5 {!l_c_0 && !(m == I) && ((m == U) => (!l_u_0 && (initial(l_u_0) || initial(l_c_0)))) && ((m == D) => (initial(l_c_0)));} in (L0)

invariant I6 {!l_c_1 && !(m == I) && ((m == U) => (!l_u_1 && (initial(l_u_1) || initial(l_c_1)))) && ((m == D) => (!l_d_1 && (initial(l_d_1) || initial(l_c_1))));} in (L1)

invariant I7 {!l_c_2 && !(m == I) && ((m == U) => (initial(l_c_2))) && ((m == D) => (!l_d_2 && (initial(l_d_2) || initial(l_c_2))));} in (L2)


// mode-switching
invariant I9 {(m == U) => (f_sw_u <= f && ((f == 1 && f_sw_u == 0) => (!l_c_0 && !l_u_0)) && ((f == 2 && f_sw_u == 0) => (!l_c_0 && !l_u_0 && !l_c_1 && !l_u_1)) && ((f == 2 && f_sw_u == 1) => (!l_c_1 && !l_u_1)));}
invariant I8 {(m == D) => (f <= f_sw_d && ((f == 0 && f_sw_d == 1) => (!l_c_1 && !l_d_1)) && ((f == 0 && f_sw_d == 2) => (!l_c_1 && !l_d_1 && !l_c_2 && !l_d_2)) && ((f == 1 && f_sw_d == 2) => (!l_c_2 && !l_d_2)));}
invariant I10 {f_sw_u <= f_sw_d;}
invariant I11 {m_prev != m;} in (SetMotionDown, SetMotionUp, SetIdle)
invariant I13 {m == U && ((f == 0) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_c_2)) && ((f == 1) => (l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_c_2)) && ((f == 2) => (l_d_2 || l_c_2));} in (MoveUp, SetMotionUp)
invariant I12 {m == D && ((f == 0) => (l_u_0 || l_c_0)) && ((f == 1) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1)) && ((f == 2) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_c_2));} in (MoveDown, SetMotionDown)


goal {
check for 26 
}
}