option-trace = true;
graph Lift5 {
const int U = 0;
const int D = 1;
const int I = 2;
int m where m == U || m == D || m == I , m_prev = m where m_prev == U || m_prev == D || m_prev == I;
bool l_c_0, l_c_1, l_c_2, l_c_3, l_c_4, l_u_0, l_u_1, l_u_2, l_u_3, l_d_1, l_d_2, l_d_3, l_d_4;
int f where f >= 0 && f <= 4;
int sc = 0, sc_MoveUp = 0, sc_MoveDown = 0, sc_D = 0, sc_SetMotionUp = 0, sc_SetMotionDown = 0, sc_SetIdle = 0, sc_L0 = 0, sc_L1 = 0, sc_L2 = 0, sc_L3 = 0, sc_L4 = 0;
int f_sw_u = f where f_sw_u >= 0 && f_sw_u <= 4;
int f_sw_d = f where f_sw_d >= 0 && f_sw_d <= 4;
bool r_c_0, r_c_1, r_c_2, r_c_3, r_c_4, r_d_1, r_d_2, r_d_3, r_d_4, r_u_0, r_u_1, r_u_2, r_u_3, a_c_0 = l_c_0, a_c_1 = l_c_1, a_c_2 = l_c_2, a_c_3 = l_c_3, a_c_4 = l_c_4, a_u_0 = l_u_0, a_u_1 = l_u_1, a_u_2 = l_u_2, a_u_3 = l_u_3, a_d_1 = l_d_1, a_d_2 = l_d_2, a_d_3 = l_d_3, a_d_4 = l_d_4, s_u_0 = l_u_0, s_u_1 = l_u_1, s_u_2 = l_u_2, s_u_3 = l_u_3, s_d_1 = l_d_1, s_d_2 = l_d_2, s_d_3 = l_d_3, s_d_4 = l_d_4, s_c_0 = l_c_0, s_c_1 = l_c_1, s_c_2 = l_c_2, s_c_3 = l_c_3, s_c_4 = l_c_4;

normal state SetIdle {m_prev = m; s_u_0 = l_u_0; s_c_0 = l_c_0; s_u_1 = l_u_1; s_d_1 = l_d_1; s_c_1 = l_c_1; s_u_2 = l_u_2; s_d_2 = l_d_2; s_c_2 = l_c_2; s_u_3 = l_u_3; s_d_3 = l_d_3; s_c_3 = l_c_3; s_d_4 = l_d_4; s_c_4 = l_c_4; m = I; f_sw_u = f; f_sw_d = f; sc += 1; sc_SetIdle += 1;}
normal state SetMotionUp {m_prev = m; s_u_0 = l_u_0; s_c_0 = l_c_0; s_u_1 = l_u_1; s_d_1 = l_d_1; s_c_1 = l_c_1; s_u_2 = l_u_2; s_d_2 = l_d_2; s_c_2 = l_c_2; s_u_3 = l_u_3; s_d_3 = l_d_3; s_c_3 = l_c_3; s_d_4 = l_d_4; s_c_4 = l_c_4; m = U; f_sw_u = f; sc += 1; sc_SetMotionUp += 1;}
normal state SetMotionDown {m_prev = m; s_u_0 = l_u_0; s_c_0 = l_c_0; s_u_1 = l_u_1; s_d_1 = l_d_1; s_c_1 = l_c_1; s_u_2 = l_u_2; s_d_2 = l_d_2; s_c_2 = l_c_2; s_u_3 = l_u_3; s_d_3 = l_d_3; s_c_3 = l_c_3; s_d_4 = l_d_4; s_c_4 = l_c_4; m = D; f_sw_d = f; sc += 1; sc_SetMotionDown += 1;}
normal state MoveDown {f -= 1; sc += 1; sc_MoveDown += 1;}
normal state MoveUp {f += 1; sc += 1; sc_MoveUp += 1;}
normal state L0 {l_c_0 = false; s_c_0 = false; l_u_0 = l_u_0 && !(m == U); s_u_0 = s_u_0 && !(m == U); sc += 1; sc_L0 += 1;}
normal state L1 {l_c_1 = false; s_c_1 = false; l_u_1 = l_u_1 && !(m == U); s_u_1 = s_u_1 && !(m == U); l_d_1 = l_d_1 && !(m == D); s_d_1 = s_d_1 && !(m == D); sc += 1; sc_L1 += 1;}
normal state L2 {l_c_2 = false; s_c_2 = false; l_u_2 = l_u_2 && !(m == U); s_u_2 = s_u_2 && !(m == U); l_d_2 = l_d_2 && !(m == D); s_d_2 = s_d_2 && !(m == D); sc += 1; sc_L2 += 1;}
normal state L3 {l_c_3 = false; s_c_3 = false; l_u_3 = l_u_3 && !(m == U); s_u_3 = s_u_3 && !(m == U); l_d_3 = l_d_3 && !(m == D); s_d_3 = s_d_3 && !(m == D); sc += 1; sc_L3 += 1;}
normal state L4 {l_c_4 = false; s_c_4 = false; l_d_4 = l_d_4 && !(m == D); s_d_4 = s_d_4 && !(m == D); sc += 1; sc_L4 += 1;}
normal start final state D {fresh(r_u_0); l_u_0 = l_u_0 || r_u_0; a_u_0 = a_u_0 || r_u_0; fresh(r_c_0); l_c_0 = l_c_0 || r_c_0; a_c_0 = a_c_0 || r_c_0; fresh(r_u_1); l_u_1 = l_u_1 || r_u_1; a_u_1 = a_u_1 || r_u_1; fresh(r_d_1); l_d_1 = l_d_1 || r_d_1; a_d_1 = a_d_1 || r_d_1; fresh(r_c_1); l_c_1 = l_c_1 || r_c_1; a_c_1 = a_c_1 || r_c_1; fresh(r_u_2); l_u_2 = l_u_2 || r_u_2; a_u_2 = a_u_2 || r_u_2; fresh(r_d_2); l_d_2 = l_d_2 || r_d_2; a_d_2 = a_d_2 || r_d_2; fresh(r_c_2); l_c_2 = l_c_2 || r_c_2; a_c_2 = a_c_2 || r_c_2; fresh(r_u_3); l_u_3 = l_u_3 || r_u_3; a_u_3 = a_u_3 || r_u_3; fresh(r_d_3); l_d_3 = l_d_3 || r_d_3; a_d_3 = a_d_3 || r_d_3; fresh(r_c_3); l_c_3 = l_c_3 || r_c_3; a_c_3 = a_c_3 || r_c_3; fresh(r_d_4); l_d_4 = l_d_4 || r_d_4; a_d_4 = a_d_4 || r_d_4; fresh(r_c_4); l_c_4 = l_c_4 || r_c_4; a_c_4 = a_c_4 || r_c_4; sc += 1; sc_D += 1;}

edge {D -> MoveUp where m == U && !((f == 0) && (l_u_0 || l_c_0) || (f == 1) && (l_u_1 || l_c_1) || (f == 2) && (l_u_2 || l_c_2) || (f == 3) && (l_u_3 || l_c_3) || (f == 4) && (l_c_4)) && ((f == 0) && (l_u_1 || l_u_2 || l_u_3 || l_d_1 || l_d_2 || l_d_3 || l_d_4 || l_c_1 || l_c_2 || l_c_3 || l_c_4) || (f == 1) && (l_u_2 || l_u_3 || l_d_2 || l_d_3 || l_d_4 || l_c_2 || l_c_3 || l_c_4) || (f == 2) && (l_u_3 || l_d_3 || l_d_4 || l_c_3 || l_c_4) || (f == 3) && (l_d_4 || l_c_4));}
edge {D -> MoveDown where m == D && !((f == 0) && (l_c_0) || (f == 1) && (l_d_1 || l_c_1) || (f == 2) && (l_d_2 || l_c_2) || (f == 3) && (l_d_3 || l_c_3) || (f == 4) && (l_d_4 || l_c_4)) && ((f == 1) && (l_u_0 || l_c_0) || (f == 2) && (l_u_0 || l_u_1 || l_d_1 || l_c_0 || l_c_1) || (f == 3) && (l_u_0 || l_u_1 || l_u_2 || l_d_1 || l_d_2 || l_c_0 || l_c_1 || l_c_2) || (f == 4) && (l_u_0 || l_u_1 || l_u_2 || l_u_3 || l_d_1 || l_d_2 || l_d_3 || l_c_0 || l_c_1 || l_c_2 || l_c_3));}
edge {D -> SetMotionDown where (f == 1) && ((m == U && !l_u_2 && !l_u_3 && !l_d_2 && !l_d_3 && !l_d_4 && !l_c_2 && !l_c_3 && !l_c_4 && !l_u_1 && !l_c_1) || m == I) && (l_u_0 || l_c_0 || l_d_1 || (m == I && l_c_1)) || (f == 2) && ((m == U && !l_u_3 && !l_d_3 && !l_d_4 && !l_c_3 && !l_c_4 && !l_u_2 && !l_c_2) || m == I) && (l_u_0 || l_u_1 || l_d_1 || l_c_0 || l_c_1 || l_d_2 || (m == I && l_c_2)) || (f == 3) && ((m == U && !l_d_4 && !l_c_4 && !l_u_3 && !l_c_3) || m == I) && (l_u_0 || l_u_1 || l_u_2 || l_d_1 || l_d_2 || l_c_0 || l_c_1 || l_c_2 || l_d_3 || (m == I && l_c_3)) || (f == 4) && ((m == U && !l_c_4) || m == I) && (l_u_0 || l_u_1 || l_u_2 || l_u_3 || l_d_1 || l_d_2 || l_d_3 || l_c_0 || l_c_1 || l_c_2 || l_c_3 || l_d_4 || (m == I && l_c_4));}
edge {D -> SetMotionUp where (f == 0) && ((m == D && !l_c_0) || m == I) && (l_u_1 || l_u_2 || l_u_3 || l_d_1 || l_d_2 || l_d_3 || l_d_4 || l_c_1 || l_c_2 || l_c_3 || l_c_4 || l_u_0 || (m == I && l_c_0)) || (f == 1) && ((m == D && !l_u_0 && !l_c_0 && !l_d_1 && !l_c_1) || m == I) && (l_u_2 || l_u_3 || l_d_2 || l_d_3 || l_d_4 || l_c_2 || l_c_3 || l_c_4 || l_u_1 || (m == I && l_c_1)) || (f == 2) && ((m == D && !l_u_0 && !l_u_1 && !l_d_1 && !l_c_0 && !l_c_1 && !l_d_2 && !l_c_2) || m == I) && (l_u_3 || l_d_3 || l_d_4 || l_c_3 || l_c_4 || l_u_2 || (m == I && l_c_2)) || (f == 3) && ((m == D && !l_u_0 && !l_u_1 && !l_u_2 && !l_d_1 && !l_d_2 && !l_c_0 && !l_c_1 && !l_c_2 && !l_d_3 && !l_c_3) || m == I) && (l_d_4 || l_c_4 || l_u_3 || (m == I && l_c_3));}
edge {D -> SetIdle where !(m == I) && !l_u_0 && !l_u_1 && !l_u_2 && !l_u_3 && !l_d_1 && !l_d_2 && !l_d_3 && !l_d_4 && !l_c_0 && !l_c_1 && !l_c_2 && !l_c_3 && !l_c_4;}
edge {D -> L0 where f == 0 && !(m == I) && (l_c_0 || (m == U && l_u_0));}
edge {D -> L1 where f == 1 && !(m == I) && (l_c_1 || (m == U && l_u_1) || (m == D && l_d_1));}
edge {D -> L2 where f == 2 && !(m == I) && (l_c_2 || (m == U && l_u_2) || (m == D && l_d_2));}
edge {D -> L3 where f == 3 && !(m == I) && (l_c_3 || (m == U && l_u_3) || (m == D && l_d_3));}
edge {D -> L4 where f == 4 && !(m == I) && (l_c_4 || (m == D && l_d_4));}
edge {SetMotionUp -> D}
edge {SetMotionDown -> D}
edge {SetIdle -> D}
edge {MoveUp -> D}
edge {MoveDown -> D}
edge {L0 -> D}
edge {L1 -> D}
edge {L2 -> D}
edge {L3 -> D}
edge {L4 -> D}
edge {D -> D where m == I && !l_u_0 && !l_u_1 && !l_u_2 && !l_u_3 && !l_d_1 && !l_d_2 && !l_d_3 && !l_d_4 && !l_c_0 && !l_c_1 && !l_c_2 && !l_c_3 && !l_c_4;}

invariant I3 {(initial(m) == I && sc == 2 && (initial(l_c_0) || initial(l_c_1) || initial(l_c_2) || initial(l_c_3) || initial(l_c_4) || initial(l_u_0) || initial(l_u_1) || initial(l_u_2) || initial(l_u_3) || initial(l_d_1) || initial(l_d_2) || initial(l_d_3) || initial(l_d_4))) => (m == U && sc_SetMotionUp == 1 || m == D && sc_SetMotionDown == 1);}


// level-handling
invariant I4 {(a_u_0 || a_c_0) == (sc_L0 != 0) && !l_u_0 && !l_c_0 && (a_u_1 || a_d_1 || a_c_1) == (sc_L1 != 0) && !l_u_1 && !l_d_1 && !l_c_1 && (a_u_2 || a_d_2 || a_c_2) == (sc_L2 != 0) && !l_u_2 && !l_d_2 && !l_c_2 && (a_u_3 || a_d_3 || a_c_3) == (sc_L3 != 0) && !l_u_3 && !l_d_3 && !l_c_3 && (a_d_4 || a_c_4) == (sc_L4 != 0) && !l_d_4 && !l_c_4;} in (SetIdle)
invariant I5 {!l_c_0 && !(m == I) && ((m == U) => (!l_u_0 && (a_u_0 || a_c_0))) && ((m == D) => (a_c_0));} in (L0)

invariant I6 {!l_c_1 && !(m == I) && ((m == U) => (!l_u_1 && (a_u_1 || a_c_1))) && ((m == D) => (!l_d_1 && (a_d_1 || a_c_1)));} in (L1)

invariant I7 {!l_c_2 && !(m == I) && ((m == U) => (!l_u_2 && (a_u_2 || a_c_2))) && ((m == D) => (!l_d_2 && (a_d_2 || a_c_2)));} in (L2)

invariant I8 {!l_c_3 && !(m == I) && ((m == U) => (!l_u_3 && (a_u_3 || a_c_3))) && ((m == D) => (!l_d_3 && (a_d_3 || a_c_3)));} in (L3)

invariant I9 {!l_c_4 && !(m == I) && ((m == U) => (a_c_4)) && ((m == D) => (!l_d_4 && (a_d_4 || a_c_4)));} in (L4)


// mode-switching
invariant I11 {(m == U) => (f_sw_u <= f && ((f == 1 && f_sw_u == 0) => (!s_c_0 && !s_u_0)) && ((f == 2 && f_sw_u == 0) => (!s_c_0 && !s_u_0 && !s_c_1 && !s_u_1)) && ((f == 2 && f_sw_u == 1) => (!s_c_1 && !s_u_1)) && ((f == 3 && f_sw_u == 0) => (!s_c_0 && !s_u_0 && !s_c_1 && !s_u_1 && !s_c_2 && !s_u_2)) && ((f == 3 && f_sw_u == 1) => (!s_c_1 && !s_u_1 && !s_c_2 && !s_u_2)) && ((f == 3 && f_sw_u == 2) => (!s_c_2 && !s_u_2)) && ((f == 4 && f_sw_u == 0) => (!s_c_0 && !s_u_0 && !s_c_1 && !s_u_1 && !s_c_2 && !s_u_2 && !s_c_3 && !s_u_3)) && ((f == 4 && f_sw_u == 1) => (!s_c_1 && !s_u_1 && !s_c_2 && !s_u_2 && !s_c_3 && !s_u_3)) && ((f == 4 && f_sw_u == 2) => (!s_c_2 && !s_u_2 && !s_c_3 && !s_u_3)) && ((f == 4 && f_sw_u == 3) => (!s_c_3 && !s_u_3)));}
invariant I10 {(m == D) => (f <= f_sw_d && ((f == 0 && f_sw_d == 1) => (!s_c_1 && !s_d_1)) && ((f == 0 && f_sw_d == 2) => (!s_c_1 && !s_d_1 && !s_c_2 && !s_d_2)) && ((f == 0 && f_sw_d == 3) => (!s_c_1 && !s_d_1 && !s_c_2 && !s_d_2 && !s_c_3 && !s_d_3)) && ((f == 0 && f_sw_d == 4) => (!s_c_1 && !s_d_1 && !s_c_2 && !s_d_2 && !s_c_3 && !s_d_3 && !s_c_4 && !s_d_4)) && ((f == 1 && f_sw_d == 2) => (!s_c_2 && !s_d_2)) && ((f == 1 && f_sw_d == 3) => (!s_c_2 && !s_d_2 && !s_c_3 && !s_d_3)) && ((f == 1 && f_sw_d == 4) => (!s_c_2 && !s_d_2 && !s_c_3 && !s_d_3 && !s_c_4 && !s_d_4)) && ((f == 2 && f_sw_d == 3) => (!s_c_3 && !s_d_3)) && ((f == 2 && f_sw_d == 4) => (!s_c_3 && !s_d_3 && !s_c_4 && !s_d_4)) && ((f == 3 && f_sw_d == 4) => (!s_c_4 && !s_d_4)));}
invariant I12 {f_sw_u <= f_sw_d;}
invariant I13 {m_prev != m;} in (SetMotionDown, SetMotionUp, SetIdle)
invariant I15 {m == U && ((f == 0) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 1) => (l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 2) => (l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 3) => (l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4)) && ((f == 4) => (l_d_4 || l_c_4));} in (MoveUp, SetMotionUp)
invariant I14 {m == D && ((f == 0) => (l_u_0 || l_c_0)) && ((f == 1) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1)) && ((f == 2) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2)) && ((f == 3) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3)) && ((f == 4) => (l_u_0 || l_c_0 || l_d_1 || l_u_1 || l_c_1 || l_d_2 || l_u_2 || l_c_2 || l_d_3 || l_u_3 || l_c_3 || l_d_4 || l_c_4));} in (MoveDown, SetMotionDown)


goal {
check for 42 reach (MoveUp, MoveDown, D, SetMotionUp, SetMotionDown, SetIdle, L0, L1, L2, L3, L4)
}
}